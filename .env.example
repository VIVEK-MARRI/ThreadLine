# ThreadLine environment configuration
# Copy to .env and edit as needed. All values have sensible defaults.

# ──────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────
# APP_NAME=Threadline
# APP_VERSION=0.1.0
# API_V1_PREFIX=/api/v1
# DEBUG=false

# ──────────────────────────────────────────────────────────
# LLM / Extraction (optional — fake provider works without a key)
# ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...your-key...
# OPENAI_MODEL=gpt-4o
# EXTRACTION_PROVIDER=openai        # "openai" or "fake"
# NL_PROVIDER=fake                  # "fake" or "openai"

# ──────────────────────────────────────────────────────────
# Semantic index
# ──────────────────────────────────────────────────────────
# SEMANTIC_INDEX_BACKEND=in_memory  # "in_memory" or "persistent"
# SEMANTIC_INDEX_PATH=.threadline/semantic_index.json
# EMBEDDING_PROVIDER=fake           # "fake" or "openai"
# ACTIVE_EMBEDDING_MODEL=fake
# ACTIVE_REPRESENTATION_VERSION=1.0

# ──────────────────────────────────────────────────────────
# Source database (REQUIRED for production)
# ──────────────────────────────────────────────────────────
SOURCE_REPOSITORY_BACKEND=database
SOURCE_DATABASE_PATH=.threadline/threadline.db

# ──────────────────────────────────────────────────────────
# Background worker (REQUIRED for production)
# ──────────────────────────────────────────────────────────
BACKGROUND_WORKER_ENABLED=true
# BACKGROUND_POLL_INTERVAL_SECONDS=1.0
# BACKGROUND_MAX_ATTEMPTS=3
# BACKGROUND_LEASE_SECONDS=60

# ──────────────────────────────────────────────────────────
# Proactive intelligence (Stage 34 — optional, off by default)
# ──────────────────────────────────────────────────────────
# Recurring per-organisation ORGANISATION_INTELLIGENCE_SCAN jobs driven by
# the process-local worker. Single-node only. Enable explicitly; queries
# work identically with it off (scans only make intelligence durable early).
# PROACTIVE_INTELLIGENCE_ENABLED=false
# PROACTIVE_INTELLIGENCE_INTERVAL_SECONDS=3600.0   # must be > 0

# ──────────────────────────────────────────────────────────
# Expensive-endpoint rate limiting (Stage 34 — process-local)
# ──────────────────────────────────────────────────────────
# POST /api/v1/query and /api/v1/query/evidence share one per-user sliding
# window. Each process enforces its own window (not global across hosts).
# QUERY_RATE_LIMIT_REQUESTS=60
# QUERY_RATE_LIMIT_WINDOW_SECONDS=60.0

# ──────────────────────────────────────────────────────────
# Authentication / security
# ──────────────────────────────────────────────────────────
# AUTH_SESSION_TTL_SECONDS=86400
# AUTH_PBKDF2_ITERATIONS=600000
# AUTH_OPEN_BOOTSTRAP=true          # set false after first owner is created
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# ──────────────────────────────────────────────────────────
# Live OpenAI integration tests (Stage 34 — opt-in, default off)
# ──────────────────────────────────────────────────────────
# The default suite never touches the network. Set both to run real
# provider calls (structural assertions only, no recorded outputs).
# RUN_LIVE_OPENAI_TESTS=false
# OPENAI_API_KEY is read from the environment, never committed.
